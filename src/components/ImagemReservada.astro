---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

// Espaço de foto: com `src` mostra a imagem otimizada; sem `src` mostra a reserva com a descrição.
interface Props {
  descricao: string;
  proporcao: string; // ex.: '4/3'
  raio?: 'g' | 'm' | 'escudo';
  src?: ImageMetadata;
  alt?: string;
  prioridade?: boolean;
  sizes?: string;
  fundo?: string;
  class?: string;
}
const { descricao, proporcao, raio = 'm', src, alt = '', prioridade = false, sizes = '(min-width: 1024px) 50vw, 100vw', fundo, class: classe } = Astro.props;
---

<figure class:list={['foto', `foto--${raio}`, classe]} style={`aspect-ratio: ${proporcao};${fundo ? ` background:${fundo};` : ''}`}>
  {src ? (
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      sizes={sizes}
      widths={[480, 800, 1200]}
      loading={prioridade ? 'eager' : 'lazy'}
      fetchpriority={prioridade ? 'high' : 'auto'}
    />
  ) : (
    <figcaption class="foto__reserva">
      <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="16" rx="2.5" /><circle cx="9" cy="10" r="2" /><path d="m4 18 5-5 4 4 3-3 4 4" /></svg>
      <span>{descricao}</span>
      <small>Proporção {proporcao.replace('/', ':')}</small>
    </figcaption>
  )}
</figure>

<style>
  .foto { margin: 0; overflow: hidden; background: var(--cinza-fundo); position: relative; }
  .foto--m { border-radius: var(--raio-m); }
  .foto--g { border-radius: var(--raio-g); }
  .foto--escudo { border-radius: var(--raio-escudo); }
  .foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .foto__reserva {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.35rem;
    padding: 1rem;
    text-align: center;
    color: var(--texto-suave);
    font-size: 0.875rem;
    border: 2px dashed var(--cinza-linha);
    border-radius: inherit;
  }
  .foto__reserva span { font-weight: 500; max-width: 24ch; }
  /* reserva sobre fundo colorido: texto escuro para manter contraste */
  .foto[style*="background"] .foto__reserva { color: var(--marinho-profundo); border-color: rgb(255 255 255 / 0.6); }
  .foto__reserva small { font-size: 0.8rem; }
</style>
