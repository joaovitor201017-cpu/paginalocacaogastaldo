---
import { Image } from 'astro:assets';
import Marquee from '../Marquee.astro';
import { imobiliarias } from '../../data/imobiliarias';
import { alturaLogo } from '../../lib/logos';
---

<div class="faixa">
  <div class="container faixa__interna">
    <p class="faixa__frase">Parceira das principais imobiliárias do ABC</p>
    <Marquee class="faixa__marquee" rotulo="Imobiliárias parceiras" duracao={30}>
      {imobiliarias.map((i) => (
        <li class="faixa__item" title={i.cidade ?? undefined}>
          {i.logoCinza ? <Image src={i.logoCinza} alt={i.nome} height={alturaLogo(i.logoCinza.width, i.logoCinza.height, { area: 4200, max: 50 })} densities={[1, 2]} loading="lazy" /> : <span>{i.nome}</span>}
        </li>
      ))}
    </Marquee>
  </div>
</div>

<style>
  .faixa { border-block: 1px solid var(--cinza-linha); background: var(--branco); }
  .faixa__interna { display: flex; align-items: center; gap: 2rem; padding-block: 0.8rem; }
  .faixa__frase { flex: 0 0 auto; margin: 0; max-width: 22ch; font-size: 0.8125rem; font-weight: 500; color: var(--texto-suave); line-height: 1.35; }
  .faixa :global(.faixa__marquee) { flex: 1; min-width: 0; --espaco: clamp(2.5rem, 5vw, 4.5rem); }
  .faixa :global(.faixa__item) { flex: 0 0 auto; color: var(--texto-suave); font-weight: 600; font-size: 0.9375rem; letter-spacing: -0.01em; white-space: nowrap; }
  .faixa :global(.faixa__item img) { display: block; width: auto; }
  @media (max-width: 700px) {
    .faixa__interna { flex-direction: column; align-items: stretch; gap: 0.6rem; }
    .faixa__frase { max-width: none; }
  }
</style>
