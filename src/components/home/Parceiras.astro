---
import { Image } from 'astro:assets';
import Botao from '../Botao.astro';
import Marquee from '../Marquee.astro';
import { imobiliarias } from '../../data/imobiliarias';
import { alturaLogo } from '../../lib/logos';
import { site } from '../../data/site';
import { linkWhatsApp } from '../../lib/whatsapp';
---

<section id="imobiliarias" class="secao parceiras" aria-labelledby="parceiras-titulo">
  <div class="container">
    <div class="parceiras__painel">
      <div class="parceiras__topo">
        <h2 id="parceiras-titulo">Referência em seguros locatícios no ABC</h2>
        <p>
          Imobiliárias de todo o ABC escolheram a Gastaldo para cuidar das garantias dos seus contratos de aluguel. Essa parceria é a nossa maior prova de confiança.
        </p>
      </div>

      <h3>Imobiliárias parceiras</h3>
      <Marquee class="parceiras__marquee" rotulo="Imobiliárias parceiras da Gastaldo" duracao={40}>
        {imobiliarias.map((i) => (
          <li class="parceira-card" title={i.cidade ?? undefined}>
            {i.logo ? <Image src={i.logo} alt={i.nome} height={alturaLogo(i.logo.width, i.logo.height, { area: 6000, max: 60 })} densities={[1, 2]} loading="lazy" /> : <span>{i.nome}</span>}
          </li>
        ))}
      </Marquee>

      <Botao href={linkWhatsApp('Olá! Quero ser uma imobiliária parceira da Gastaldo.', site.whatsapp)} variante="claro">
        Quero ser uma imobiliária parceira
      </Botao>
    </div>
  </div>
</section>

<style>
  .parceiras { padding-block: calc(var(--respiro) * 0.5); }
  .parceiras__painel {
    background: var(--marinho-profundo);
    color: rgb(255 255 255 / 0.82);
    border-radius: var(--raio-g);
    padding: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
  }
  .parceiras h2, .parceiras h3 { color: var(--branco); }
  .parceiras h3 { font-size: 1.05rem; margin-bottom: 1rem; }
  .parceiras__topo { max-width: 60ch; margin-bottom: 2rem; }
  .parceiras :global(.parceiras__marquee) { margin-bottom: 2.25rem; }
  .parceiras :global(.parceira-card) {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    min-width: 170px;
    min-height: 84px;
    padding: 0.75rem 1.25rem;
    background: var(--branco);
    border-radius: var(--raio-p);
    color: var(--marinho);
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .parceiras :global(.parceira-card img) { display: block; width: auto; }

  @media (max-width: 560px) {
    .parceiras__painel { padding: 2rem 1.25rem; }
    .parceiras :global(.parceira-card) { min-width: 140px; min-height: 64px; }
  }
</style>
