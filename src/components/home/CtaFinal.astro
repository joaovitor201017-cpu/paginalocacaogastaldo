---
import Botao from '../Botao.astro';
import { site } from '../../data/site';
import { linkWhatsApp } from '../../lib/whatsapp';
---

<section id="cta-final" class="cta" aria-labelledby="cta-titulo">
  <div class="container">
    <div class="cta__painel">
      <svg class="cta__escudo" aria-hidden="true" viewBox="66 40 200 256"><path fill="currentColor" fill-rule="evenodd" d="M197.64 42.62v36.63h-90.72v90.91c-8.64 86.58 90.72 86.58 90.72 86.58v36.3C70.2 302.69 70.2 179.15 70.2 179.15V42.62Z"></path></svg>
      <h2 id="cta-titulo">Pronto para alugar sem fiador?</h2>
      <p>Simule sua garantia em 1 minuto ou fale com a nossa equipe. Atendemos inquilinos, proprietários e imobiliárias em todo o ABC.</p>
      <div class="cta__acoes">
        <Botao href="/simulador-seguro-fianca" variante="claro" tamanho="g">Simular minha garantia</Botao>
        <Botao href={linkWhatsApp(site.mensagemWhatsApp, site.whatsapp)} variante="whatsapp" tamanho="g">Falar no WhatsApp</Botao>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: 0 var(--respiro); }
  .cta__painel {
    position: relative;
    overflow: hidden;
    background: var(--marinho);
    color: rgb(255 255 255 / 0.85);
    border-radius: var(--raio-g) var(--raio-g) var(--raio-g) clamp(80px, 14vw, 180px);
    padding: clamp(2.5rem, 2rem + 4vw, 5.5rem) clamp(1.5rem, 1rem + 5vw, 6rem);
  }
  .cta h2 { color: var(--branco); max-width: 16ch; font-size: clamp(2rem, 1.5rem + 2.4vw, 3.25rem); }
  .cta p { max-width: 50ch; font-size: 1.1rem; margin-bottom: 2rem; }
  .cta__acoes { display: flex; flex-wrap: wrap; gap: 0.85rem; position: relative; }
  @media (max-width: 480px) {
    .cta__acoes :global(.botao) { flex: 1 1 100%; }
    .cta__escudo { display: none; }
  }
  /* Escudo do logo como marca d'água */
  .cta__escudo { position: absolute; right: -2%; bottom: -18%; width: clamp(180px, 30vw, 380px); color: var(--azul-claro); opacity: 0.14; pointer-events: none; }
</style>
