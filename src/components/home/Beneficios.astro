---
import Botao from '../Botao.astro';
import { beneficios } from '../../data/beneficios';
import { site } from '../../data/site';
import { icones } from '../../lib/icones';
import { linkWhatsApp } from '../../lib/whatsapp';
---

<section id="beneficios" class="secao beneficios" aria-labelledby="beneficios-titulo">
  <div class="container">
    <div class="beneficios__topo">
      <h2 id="beneficios-titulo">Alugar no ABC nunca foi tão fácil</h2>
      <p class="intro">
        Nossas soluções para alugar foram pensadas para dar agilidade e segurança a quem aluga, a quem é dono e a quem administra o imóvel.
      </p>
    </div>

    <div class="abas__lista" role="tablist" aria-label="Benefícios por público">
      {beneficios.map((g, i) => (
        <button type="button" role="tab" id={`aba-${g.id}`} aria-controls={`painel-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          {g.aba}
        </button>
      ))}
    </div>

    {beneficios.map((g) => (
      <div class="painel" role="tabpanel" id={`painel-${g.id}`} aria-labelledby={`aba-${g.id}`}>
        <h3>{g.titulo}</h3>
        <ul class="painel__grade" tabindex="0" aria-label={`${g.titulo} (role para o lado para ver todos)`}>
          {g.itens.map((it) => (
            <li class="beneficio">
              <span class="beneficio__icone" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icones[it.icone]}></path></svg>
              </span>
              <div>
                <strong>{it.destaque}</strong>
                <p>{it.texto}</p>
              </div>
            </li>
          ))}
        </ul>
        <Botao
          href={g.botao.href ?? linkWhatsApp(g.botao.mensagemWhatsApp ?? site.mensagemWhatsApp, site.whatsapp)}
          variante={g.botao.href ? 'primario' : 'whatsapp'}
        >
          {g.botao.rotulo}
        </Botao>
      </div>
    ))}
  </div>
</section>

<script is:inline>
  // Abas acessíveis. Sem JS os três painéis aparecem empilhados.
  (() => {
    const secao = document.getElementById('beneficios');
    if (!secao) return;
    const abas = [...secao.querySelectorAll('[role="tab"]')];
    const paineis = abas.map((a) => document.getElementById(a.getAttribute('aria-controls')));
    const ativar = (i, focar) => {
      abas.forEach((a, j) => {
        const ativa = i === j;
        a.setAttribute('aria-selected', String(ativa));
        a.tabIndex = ativa ? 0 : -1;
        paineis[j].hidden = !ativa;
      });
      if (focar) abas[i].focus();
    };
    secao.classList.add('js-abas');
    ativar(0, false);
    abas.forEach((a, i) => {
      a.addEventListener('click', () => ativar(i, false));
      a.addEventListener('keydown', (e) => {
        const ult = abas.length - 1;
        const alvo = { ArrowRight: i === ult ? 0 : i + 1, ArrowLeft: i === 0 ? ult : i - 1, Home: 0, End: ult }[e.key];
        if (alvo === undefined) return;
        e.preventDefault();
        ativar(alvo, true);
      });
    });
  })();
</script>

<style>
  .beneficios__topo { max-width: 62ch; margin-bottom: 2rem; }
  .beneficios__topo .intro { margin: 0; }

  /* Abas em linha com sublinhado (só aparecem com JS) */
  .abas__lista { display: none; }
  .js-abas .abas__lista {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    box-shadow: inset 0 -2px 0 var(--cinza-linha);
  }
  .abas__lista button {
    font: inherit;
    font-weight: 600;
    font-size: 1rem;
    color: var(--texto-suave);
    background: transparent;
    border: 0;
    padding: 0.75rem 1rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .abas__lista button[aria-selected='true'] { color: var(--marinho); box-shadow: inset 0 -3px 0 var(--azul-escuro); }
  .abas__lista button:not([aria-selected='true']):hover { color: var(--marinho); }

  .painel[hidden] { display: none; }
  .painel + .painel { margin-top: 3rem; }
  .js-abas .painel + .painel { margin-top: 0; }
  .painel h3 { font-size: 1rem; margin-bottom: 0.75rem; }

  /* Benefícios na horizontal: ícone em cima, título e texto embaixo; rola quando não cabe */
  .painel__grade {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(148px, 1fr);
    gap: 0.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
    margin-bottom: 1.75rem;
    scrollbar-width: thin;
  }
  .painel__grade:focus-visible { outline-offset: 4px; }
  .beneficio {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.9rem 0.85rem;
    border: 1px solid transparent;
    border-radius: var(--raio-p);
    scroll-snap-align: start;
    transition: border-color 0.18s ease;
  }
  .beneficio:hover { border-color: var(--cinza-linha); }
  .beneficio__icone {
    display: grid; place-items: center; width: 44px; height: 44px;
    color: var(--marinho); background: var(--azul-ceu);
    border-radius: 10px 10px 10px 20px; /* eco do escudo do logo */
  }
  .beneficio strong { display: block; color: var(--marinho); font-size: 0.9375rem; line-height: 1.3; margin-bottom: 0.25rem; }
  .beneficio p { margin: 0; font-size: 0.875rem; line-height: 1.5; color: var(--texto-suave); }

  @media (max-width: 560px) {
    .painel__grade { grid-auto-columns: 62%; margin-inline: -1.25rem; padding-inline: 1.25rem; scroll-padding-inline: 1.25rem; }
    .abas__lista button { flex: 1 1 0; padding: 0.7rem 0.4rem; font-size: 0.9375rem; }
  }
</style>
