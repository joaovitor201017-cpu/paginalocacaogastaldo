---
import Botao from '../Botao.astro';
import Pendente from '../Pendente.astro';
import ImagemReservada from '../ImagemReservada.astro';
import { site } from '../../data/site';
import { numerosHero } from '../../data/numeros';
import { linkWhatsApp } from '../../lib/whatsapp';
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="container hero__grade">
    <div class="hero__texto">
      <h1 id="hero-titulo">Soluções para Alugar no ABC</h1>
      <p class="hero__sub">
        Seguro fiança, título de capitalização e seguros para alugar sem fiador e sem caução, com a corretora parceira das imobiliárias do ABC.
      </p>
      <div class="hero__acoes">
        <Botao href={linkWhatsApp(site.mensagemWhatsApp, site.whatsapp)} variante="primario" tamanho="g">Falar com um consultor</Botao>
        <Botao href="#solucoes" variante="secundario" tamanho="g">Conhecer as soluções</Botao>
      </div>
      <ul class="hero__selos">
        {numerosHero.map((n) => (
          <li>
            <strong>{n.valor ?? <Pendente rotulo={n.complemento ? 'nota' : 'número'} />}</strong>
            <span>
              {n.rotulo}
              {n.complemento && (
                <>
                  {' '}{n.complemento.valor ?? <Pendente rotulo="número" />} {n.complemento.texto}
                </>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__fotos">
      <ImagemReservada class="hero__foto1" descricao="Foto: pessoas felizes na mudança para o imóvel alugado" proporcao="4/5" raio="escudo" prioridade />
      <ImagemReservada class="hero__foto2" descricao="Foto: chaves com chaveiro de casa" proporcao="1/1" raio="g" fundo="var(--azul-claro)" />
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(2.5rem, 2rem + 3vw, 5rem) clamp(2.5rem, 2rem + 2vw, 4rem); }
  .hero__grade { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 4.5rem); align-items: center; }
  .hero h1 { max-width: 12ch; margin-bottom: 1.25rem; }
  .hero__sub { font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem); color: var(--texto-suave); max-width: 46ch; margin-bottom: 2rem; }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-bottom: 2.5rem; }

  .hero__selos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 2rem; padding-top: 1.75rem; border-top: 1px solid var(--cinza-linha); }
  .hero__selos li { display: grid; gap: 0.15rem; }
  .hero__selos strong { font-size: 1.6rem; font-weight: 700; color: var(--marinho); line-height: 1.2; letter-spacing: -0.02em; }
  .hero__selos span { font-size: var(--fs-pequeno); color: var(--texto-suave); line-height: 1.4; }

  /* Colagem: foto principal com moldura em escudo + quadro das chaves sobreposto */
  .hero__fotos { position: relative; padding: 0 0 12% 0; }
  .hero__fotos :global(.hero__foto1) { width: 78%; margin-left: auto; }
  .hero__fotos :global(.hero__foto2) { position: absolute; left: 0; bottom: 0; width: 42%; border: 6px solid var(--branco); }

  @media (max-width: 900px) {
    .hero__grade { grid-template-columns: minmax(0, 1fr); }
    .hero__fotos { max-width: 520px; width: 100%; margin-inline: auto; }
  }
  @media (max-width: 480px) {
    .hero__acoes :global(.botao) { flex: 1 1 100%; }
  }
</style>
