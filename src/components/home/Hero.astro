---
import Botao from '../Botao.astro';
import ImagemReservada from '../ImagemReservada.astro';
import { site } from '../../data/site';
import { linkWhatsApp } from '../../lib/whatsapp';
import fotoPrincipal from '../../assets/fotos/hero-principal.jpg';
import fotoChaves from '../../assets/fotos/hero-chaves.jpg';

---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="container hero__grade">
    <div class="hero__texto">
      <h1 id="hero-titulo">Soluções para Alugar no ABC</h1>
      <p class="hero__sub">
        Seguro fiança, título de capitalização e seguros para alugar sem fiador e sem caução, com a corretora parceira das imobiliárias do ABC.
      </p>
      <div class="hero__acoes">
        <Botao href={linkWhatsApp(site.mensagemWhatsApp, site.whatsapp)} variante="primario" tamanho="g">Falar com um consultor</Botao>
        <Botao href="#solucoes" variante="secundario" tamanho="g">Conhecer as soluções</Botao>
      </div>
    </div>

    <div class="hero__fotos">
      <ImagemReservada class="hero__foto1" descricao="Foto: pessoas felizes na mudança para o imóvel alugado" proporcao="4/5" raio="escudo" prioridade src={fotoPrincipal} alt="Casal sorrindo carregando caixas de mudança no apartamento alugado" sizes="(min-width: 900px) 370px, 78vw" />
      <ImagemReservada class="hero__foto2" descricao="Foto: chaves com chaveiro de casa" proporcao="1/1" raio="g" fundo="var(--azul-claro)" src={fotoChaves} alt="Entrega das chaves do imóvel alugado" sizes="(min-width: 900px) 220px, 46vw" />
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(2rem, 1.5rem + 2.5vw, 3.75rem) clamp(2rem, 1.5rem + 2vw, 3rem); }
  .hero__grade { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .hero h1 { max-width: 13ch; margin-bottom: 1rem; font-size: clamp(2.25rem, 1.7rem + 2.4vw, 3.5rem); }
  .hero__sub { font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); color: var(--texto-suave); max-width: 46ch; margin-bottom: 1.75rem; }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; }


  /* Colagem: foto principal com moldura em escudo + quadro das chaves sobreposto */
  .hero__fotos { position: relative; padding: 0 0 10% 0; max-width: 470px; width: 100%; justify-self: end; }
  .hero__fotos :global(.hero__foto1) { width: 78%; margin-left: auto; }
  .hero__fotos :global(.hero__foto2) { position: absolute; left: 0; bottom: 0; width: 46%; border: 5px solid var(--branco); }

  @media (max-width: 900px) {
    .hero__grade { grid-template-columns: minmax(0, 1fr); }
    .hero__fotos { max-width: 400px; justify-self: center; }
  }
  @media (max-width: 480px) {
    .hero__acoes :global(.botao) { flex: 1 1 100%; }
  }
</style>
