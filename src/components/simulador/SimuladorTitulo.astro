---
import { site } from '../../data/site';
import { cidades } from '../../data/cidades';
import { simuladorTitulo as s } from '../../data/simuladores/titulo-de-capitalizacao';
import { numeroWhatsApp } from '../../lib/whatsapp';
import '../../styles/simulador.css';

// Calculadora do título de capitalização em 2 passos + resultado (aba 01 do documento do João).
// Título = (aluguel + condomínio + IPTU) × número de aluguéis; parcela de exemplo = título ÷ 18.
// "Ainda não sei" mostra as colunas de 6x e 12x lado a lado.
const numero = numeroWhatsApp(site.whatsapp);
const etapas = ['Aluguel', 'Seus dados', 'Resultado'];
const linhas = [
  { campo: 'mensal', rotulo: 'Valor mensal do aluguel com encargos' },
  { campo: 'titulo', rotulo: 'Valor do título' },
  { campo: 'parcela', rotulo: 'Parcelamento de exemplo' },
  { campo: 'volta', rotulo: 'Valor que volta no fim', nota: 'Até 100% do valor, conforme o plano' },
];
---

<form class="sim" action={`https://wa.me/${numero}`} method="get" target="_blank" novalidate data-simulador-titulo data-whatsapp={numero} data-planilha={site.planilhaLeads ?? undefined}>
  <input type="hidden" name="text" value={s.mensagemWhatsApp} />

  <ol class="sim__progresso" aria-label="Etapas da simulação">
    {etapas.map((e, i) => <li data-etapa={i + 1} aria-current={i === 0 ? 'step' : undefined}><span>{i + 1}</span>{e}</li>)}
  </ol>

  <!-- Passo 1 -->
  <fieldset class="sim__passo" data-passo="1">
    <legend>Dados do aluguel</legend>
    <label class="sim__campo">
      Valor do aluguel (R$)
      <input name="aluguel" inputmode="decimal" autocomplete="off" placeholder="2.000" required aria-describedby="t-ajuda-aluguel" />
      <small id="t-ajuda-aluguel">Valor mensal, sem condomínio</small>
      <span class="sim__erro" data-erro="aluguel" aria-live="polite"></span>
    </label>
    <div class="sim__duplo">
      <label class="sim__campo">
        Condomínio (R$)
        <input name="condominio" inputmode="decimal" autocomplete="off" placeholder="Opcional" />
        <small>Deixe em branco se não tiver</small>
        <span class="sim__erro" data-erro="condominio" aria-live="polite"></span>
      </label>
      <label class="sim__campo">
        IPTU por mês (R$)
        <input name="iptu" inputmode="decimal" autocomplete="off" placeholder="Opcional" />
        <small>Se pagar por ano, divida por 12</small>
        <span class="sim__erro" data-erro="iptu" aria-live="polite"></span>
      </label>
    </div>
    <fieldset class="sim__opcoes">
      <legend>Quantos aluguéis a imobiliária pediu?</legend>
      {s.opcoesVezes.map((v) => <label><input type="radio" name="vezes" value={String(v)} required /> {v}x</label>)}
      <label><input type="radio" name="vezes" value="nao-sei" /> Ainda não sei</label>
    </fieldset>
    <small class="sim__ajuda">Pergunte à imobiliária. Se não souber, mostramos 6x e 12x</small>
    <span class="sim__erro" data-erro="vezes" aria-live="polite"></span>
    <fieldset class="sim__opcoes">
      <legend>Tipo de imóvel</legend>
      <label><input type="radio" name="tipo" value="Residencial" required checked /> Residencial</label>
      <label><input type="radio" name="tipo" value="Comercial" /> Comercial</label>
    </fieldset>
    <label class="sim__campo">
      Cidade
      <select name="cidade" required>
        <option value="">Selecione</option>
        {cidades.map((c) => <option>{c.nome}</option>)}
        <option>Outra cidade</option>
      </select>
      <span class="sim__erro" data-erro="cidade" aria-live="polite"></span>
    </label>
    <button type="button" class="sim__botao" data-avancar>Calcular meu título</button>
  </fieldset>

  <!-- Passo 2 -->
  <fieldset class="sim__passo" data-passo="2">
    <legend>Seus dados</legend>
    <label class="sim__campo">
      Nome
      <input name="nome" autocomplete="name" required />
      <span class="sim__erro" data-erro="nome" aria-live="polite"></span>
    </label>
    <label class="sim__campo">
      WhatsApp
      <input name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" placeholder="(11) 91234-5678" required />
      <span class="sim__erro" data-erro="whatsapp" aria-live="polite"></span>
    </label>
    <fieldset class="sim__opcoes">
      <legend>Você é</legend>
      <label><input type="radio" name="perfil" value="Inquilino" required checked /> Inquilino</label>
      <label><input type="radio" name="perfil" value="Proprietário" /> Proprietário</label>
      <label><input type="radio" name="perfil" value="Imobiliária" /> Imobiliária</label>
    </fieldset>
    <label class="sim__consentimento">
      <input type="checkbox" name="consentimento" required />
      <span>Aceito receber o contato da Gastaldo Seguros pelo WhatsApp sobre esta cotação, conforme a <a href="/politica-de-privacidade">Política de Privacidade</a>.</span>
    </label>
    <span class="sim__erro" data-erro="consentimento" aria-live="polite"></span>
    <div class="sim__acoes">
      <button type="submit" class="sim__botao">Ver meu resultado</button>
      <button type="button" class="sim__voltar" data-voltar>Voltar</button>
    </div>
    <p class="sim__seguro">Seus dados estão seguros e não são compartilhados. A simulação não consulta seu CPF.</p>
  </fieldset>

  <!-- Passo 3: resultado -->
  <div class="sim__passo sim__resultado" data-passo="3" hidden tabindex="-1">
    <h2 class="sim__titulo"><span data-nome>Você</span>, este é o valor do seu título de capitalização</h2>
    <table class="titulo-tabela">
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">Item</span></th>
          <th scope="col" data-col="0">Título de <span data-vezes="0">6</span>x</th>
          <th scope="col" data-col="1" hidden>Título de <span data-vezes="1">12</span>x</th>
        </tr>
      </thead>
      <tbody>
        {linhas.map((l) => (
          <tr>
            <th scope="row">{l.rotulo}{l.nota && <small>{l.nota}</small>}</th>
            <td data-col="0" data-campo={l.campo}>—</td>
            <td data-col="1" data-campo={l.campo} hidden>—</td>
          </tr>
        ))}
      </tbody>
    </table>
    <ul class="titulo-fixos">
      {s.resultado.fixos.map((t) => <li>{t}</li>)}
    </ul>
    <a class="sim__botao sim__botao--wpp" href={`https://wa.me/${numero}`} target="_blank" rel="noopener" data-falar>{s.resultado.botao}</a>
    <div class="titulo-comparacao">
      <p>{s.resultado.comparacao.texto}</p>
      <a href={s.resultado.comparacao.href}>{s.resultado.comparacao.botao}</a>
    </div>
    <button type="button" class="sim__voltar" data-voltar>Voltar e alterar os valores</button>
  </div>
</form>

<script>
  import { calcularTitulo, lerValor, formatarReais, formatarReaisCentavos, mensagemLeadTitulo } from '../../lib/simulador';

  const form = document.querySelector<HTMLFormElement>('[data-simulador-titulo]');
  if (form) {
    const $ = <T extends Element>(sel: string) => form.querySelector<T>(sel)!;
    const $$ = (sel: string) => [...form.querySelectorAll<HTMLElement>(sel)];
    const valor = (n: string) => String(new FormData(form).get(n) ?? '').trim();
    const campo = (n: string) => form.elements.namedItem(n) as HTMLInputElement | null;

    const ir = (n: number) => {
      $$('[data-passo]').forEach((p) => (p.hidden = p.dataset.passo !== String(n)));
      $$('[data-etapa]').forEach((e) => (Number(e.dataset.etapa) === n ? e.setAttribute('aria-current', 'step') : e.removeAttribute('aria-current')));
      const alvo = $<HTMLElement>(`[data-passo="${n}"]`);
      (n > 2 ? alvo : alvo.querySelector<HTMLElement>('input,select'))?.focus({ preventScroll: n === 1 });
      if (n > 1) form.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    };
    const erro = (n: string, msg = '') => {
      $(`[data-erro="${n}"]`).textContent = msg;
      const c = campo(n);
      if (c && 'setAttribute' in c) c.setAttribute('aria-invalid', String(Boolean(msg)));
      return !msg;
    };
    const numeroValido = (n: string, obrigatorio: boolean) => {
      const v = lerValor(valor(n));
      if (v === null) return erro(n, obrigatorio ? 'Informe o valor do aluguel para continuar.' : '');
      return erro(n, Number.isNaN(v) ? 'Digite apenas números, por exemplo 2000.' : '');
    };

    form.classList.add('sim--js');
    ir(1);

    $('[data-avancar]').addEventListener('click', () => {
      const ok = [
        numeroValido('aluguel', true),
        numeroValido('condominio', false),
        numeroValido('iptu', false),
        erro('vezes', valor('vezes') ? '' : 'Escolha quantos aluguéis a imobiliária pediu.'),
        erro('cidade', valor('cidade') ? '' : 'Escolha a cidade do imóvel.'),
      ].every(Boolean);
      if (ok) ir(2);
      else form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
    });
    $$('[data-voltar]').forEach((b) => b.addEventListener('click', () => ir(1)));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const digitos = valor('whatsapp').replace(/\D/g, '');
      const ok = [
        erro('nome', valor('nome') ? '' : 'Informe seu nome.'),
        erro('whatsapp', digitos.length >= 10 && digitos.length <= 11 ? '' : 'Confira o número com DDD, por exemplo (11) 91234-5678.'),
        erro('consentimento', campo('consentimento')?.checked ? '' : 'Marque a caixa para receber sua cotação.'),
      ].every(Boolean);
      if (!ok) return form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();

      const aluguel = lerValor(valor('aluguel')) as number;
      const condominio = lerValor(valor('condominio'));
      const iptu = lerValor(valor('iptu'));
      const vezes = valor('vezes') === 'nao-sei' ? [6, 12] : [Number(valor('vezes'))];
      const contas = vezes.map((v) => calcularTitulo({ aluguel, condominio, iptu, vezes: v }));

      $$('[data-nome]').forEach((n) => (n.textContent = valor('nome').split(' ')[0]));
      $$('[data-col="1"]').forEach((c) => (c.hidden = vezes.length < 2));
      vezes.forEach((v, i) => {
        $(`[data-vezes="${i}"]`).textContent = String(v);
        const t = contas[i];
        const texto: Record<string, string> = {
          mensal: formatarReais(t.mensal),
          titulo: formatarReais(t.titulo),
          parcela: `18x de ${formatarReaisCentavos(t.parcela)}`,
          volta: `até ${formatarReais(t.titulo)}`,
        };
        $$(`[data-col="${i}"][data-campo]`).forEach((c) => (c.textContent = texto[c.dataset.campo!]));
      });

      const lead = {
        nome: valor('nome'),
        perfil: valor('perfil'),
        aluguel,
        encargos: (condominio ?? 0) + (iptu ?? 0),
        vezes,
        titulos: contas.map((t) => t.titulo),
        tipo: valor('tipo'),
        cidade: valor('cidade'),
        whatsapp: valor('whatsapp'),
      };
      $<HTMLAnchorElement>('[data-falar]').href = `https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(mensagemLeadTitulo(lead))}`;
      ir(3);

      // Planilha de leads (quando configurada)
      if (form.dataset.planilha) fetch(form.dataset.planilha, { method: 'POST', mode: 'no-cors', body: new URLSearchParams({ produto: 'Título de capitalização', ...lead, vezes: vezes.join('/'), titulos: lead.titulos.join('/') } as unknown as Record<string, string>) }).catch(() => {});
    });
  }
</script>

<style>
  .sim__ajuda { margin-top: -0.6rem; font-size: 0.8rem; color: var(--texto-suave); }
  .titulo-tabela { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  .titulo-tabela th, .titulo-tabela td { padding: 0.75rem 0.5rem; text-align: left; border-bottom: 1px solid var(--cinza-linha); vertical-align: top; }
  .titulo-tabela thead th { font-size: 0.8125rem; color: var(--texto-suave); font-weight: 600; }
  .titulo-tabela tbody th { color: var(--texto-suave); font-weight: 500; }
  .titulo-tabela tbody th small { display: block; font-size: 0.75rem; font-weight: 400; }
  .titulo-tabela td { color: var(--marinho); font-weight: 700; white-space: nowrap; }
  .titulo-tabela td[data-campo='titulo'] { font-size: 1.25rem; }
  .titulo-tabela [hidden] { display: none; }
  .titulo-fixos { display: grid; gap: 0.4rem; padding-left: 1.1rem; list-style: disc; font-size: 0.875rem; color: var(--texto-suave); }
  .titulo-fixos li::marker { color: var(--azul-escuro); }
  .titulo-comparacao { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding: 0.9rem 1rem; background: var(--cinza-fundo); border-radius: var(--raio-p); font-size: 0.9rem; }
  .titulo-comparacao p { margin: 0; }
  .titulo-comparacao a { font-weight: 600; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* Celular: o nome do item fica em cima e os valores (6x e 12x) dividem a largura embaixo */
  @media (max-width: 560px) {
    .titulo-tabela, .titulo-tabela thead, .titulo-tabela tbody { display: block; }
    .titulo-tabela tr { display: flex; flex-wrap: wrap; column-gap: 0.75rem; border-bottom: 1px solid var(--cinza-linha); padding: 0.6rem 0; }
    .titulo-tabela th, .titulo-tabela td { flex: 1 1 0; min-width: 0; border: 0; padding: 0.15rem 0; white-space: normal; }
    .titulo-tabela tbody th { flex-basis: 100%; }
    .titulo-tabela thead th:first-child { display: none; }
    .titulo-tabela td[data-campo='titulo'] { font-size: 1.125rem; }
  }
</style>
