---
import Pendente from './Pendente.astro';
import RedesSociais from './RedesSociais.astro';
import { site } from '../data/site';
import { solucoes } from '../data/solucoes';
import { cidades } from '../data/cidades';
import { enderecoCompleto } from '../lib/endereco';
import { icones } from '../lib/icones';
import { linkWhatsApp, numeroWhatsApp } from '../lib/whatsapp';

// Rodapé: topo (logo, frase e dados da corretora), 4 colunas e faixa de baixo com as redes sociais.
// Cidades sem link até existirem as páginas de cidade.
const institucional = [
  { href: '/#contato', rotulo: 'Página de contato' },
  { href: '/#sobre', rotulo: 'Sobre a corretora' },
  { href: '/#imobiliarias', rotulo: 'Para imobiliárias' },
  { href: '/blog', rotulo: 'Blog' },
  { href: '/politica-de-privacidade', rotulo: 'Política de privacidade' },
];
const simuladores = [
  { href: '/simulador-seguro-fianca', rotulo: 'Simulador de Seguro Fiança' },
  { href: '/simulador-titulo-de-capitalizacao-aluguel', rotulo: 'Simulador de Título de Capitalização' },
  { href: '/cotacao-seguro-incendio', rotulo: 'Cotação de Seguro Incêndio' },
  { href: '/cotacao-seguro-residencial', rotulo: 'Cotação de Seguro Residencial' },
];
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="container rodape__topo">
    <img class="rodape__logo" src="/brand/logo-gastaldo-branco.png" alt="Gastaldo Seguros" width="170" height="54" loading="lazy" />
    <p class="rodape__descricao">{site.descricao}</p>
    <div class="rodape__dados">
      <strong>{site.nome}</strong>
      {site.endereco && <span>{enderecoCompleto(site.endereco)}</span>}
      {site.telefone && <a href={`tel:+${numeroWhatsApp(site.telefone)}`}>{site.telefone}</a>}
    </div>
  </div>

  <div class="container rodape__colunas">
    <div>
      <p class="rodape__titulo">Atendimento</p>
      <ul class="rodape__atendimento">
        {site.horario && (
          <li>
            <svg class="rodape__icone" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icones.relogio}></path></svg>
            <span>{site.horario}{site.horarioFimDeSemana && <><br />{site.horarioFimDeSemana}</>}</span>
          </li>
        )}
        {site.whatsapp && (
          <li>
            <svg class="rodape__icone" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icones.mensagem}></path></svg>
            <a href={linkWhatsApp(site.mensagemWhatsApp, site.whatsapp)}>WhatsApp {site.whatsapp}</a>
          </li>
        )}
        {site.email && (
          <li>
            <svg class="rodape__icone" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icones.email}></path></svg>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        )}
      </ul>
      <ul class="rodape__links">{institucional.map((l) => <li><a href={l.href}>{l.rotulo}</a></li>)}</ul>
    </div>
    <div>
      <p class="rodape__titulo">Seguros e garantias</p>
      <ul class="rodape__links">{solucoes.map((s) => <li><a href={s.saibaMais}>{s.titulo}</a></li>)}</ul>
    </div>
    <div>
      <p class="rodape__titulo">Simuladores</p>
      <ul class="rodape__links">{simuladores.map((s) => <li><a href={s.href}>{s.rotulo}</a></li>)}</ul>
    </div>
    <div>
      <p class="rodape__titulo">Cidades atendidas</p>
      <ul class="rodape__links rodape__cidades">
        {cidades.map((c) => <li>{c.href ? <a href={c.href}>{c.nome}</a> : c.nome}{c.sede && <span class="rodape__sede">sede</span>}</li>)}
      </ul>
    </div>
  </div>

  <div class="rodape__base">
    <div class="container rodape__base-grade">
      <RedesSociais tema="escuro" />
      <p>© {ano} {site.nome} · CNPJ {site.cnpj ?? <Pendente rotulo="número" />}</p>
    </div>
  </div>
</footer>

<style>
  .rodape { background: var(--marinho-profundo); color: rgb(255 255 255 / 0.82); font-size: var(--fs-pequeno); }
  .rodape a { color: inherit; text-decoration: none; }
  .rodape a:hover { color: var(--azul-ceu); text-decoration: underline; }

  /* Topo: logo | frase | dados */
  .rodape__topo { display: grid; grid-template-columns: auto minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 2rem 3rem; align-items: start; padding-block: 3.5rem 2.25rem; border-bottom: 1px solid rgb(255 255 255 / 0.14); }
  .rodape__logo { width: 170px; height: auto; }
  .rodape__descricao { margin: 0; max-width: 30ch; }
  .rodape__dados { display: grid; gap: 0.35rem; justify-self: end; text-align: right; }
  .rodape__dados strong { color: var(--branco); }
  .rodape__dados a { color: var(--branco); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  /* Colunas */
  .rodape__colunas { display: grid; grid-template-columns: 1.15fr 1fr 1.1fr 1fr; gap: 2.5rem; padding-block: 2.5rem 3rem; }
  .rodape__titulo { color: var(--branco); font-weight: 700; font-size: 1rem; margin-bottom: 1rem; }
  .rodape__atendimento { display: grid; gap: 0.75rem; margin-bottom: 1.25rem; }
  .rodape__atendimento li { display: flex; gap: 0.55rem; align-items: flex-start; }
  .rodape__icone { flex: 0 0 auto; margin-top: 0.15rem; color: var(--azul-ceu); }
  .rodape__links { display: grid; gap: 0.7rem; }
  .rodape__cidades li { display: flex; align-items: center; gap: 0.45rem; }
  .rodape__sede { font-size: 0.7rem; font-weight: 700; padding: 0.05rem 0.45rem; border-radius: 999px; background: var(--amarelo); color: var(--marinho-profundo); }

  /* Faixa de baixo */
  .rodape__base { background: rgb(0 0 0 / 0.22); }
  .rodape__base-grade { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.1rem; }
  .rodape__base p { margin: 0; font-size: 0.85rem; }

  @media (max-width: 960px) {
    .rodape__topo { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .rodape__dados { justify-self: start; text-align: left; }
    .rodape__colunas { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.5rem; }
  }
  @media (max-width: 520px) {
    .rodape__colunas { grid-template-columns: minmax(0, 1fr); }
  }
</style>
