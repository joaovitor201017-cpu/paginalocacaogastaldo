---
// Trilha de navegação (Início › [níveis intermediários] › página atual). Igual ao BreadcrumbList do schema.
interface Props { atual: string; meio?: { rotulo: string; href: string }[] }
const { atual, meio = [] } = Astro.props;
---

<nav class="trilha" aria-label="Trilha">
  <ol>
    <li><a href="/">Início</a></li>
    {meio.map((m) => <li><a href={m.href}>{m.rotulo}</a></li>)}
    <li><span aria-current="page">{atual}</span></li>
  </ol>
</nav>

<style>
  .trilha ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: 0.8125rem; color: var(--texto-suave); margin-bottom: 1.25rem; }
  .trilha li + li::before { content: '›'; margin-right: 0.4rem; color: var(--azul); }
  .trilha a { color: var(--texto-suave); }
  .trilha a:hover { color: var(--marinho); }
  .trilha [aria-current] { color: var(--marinho); font-weight: 500; }
</style>
