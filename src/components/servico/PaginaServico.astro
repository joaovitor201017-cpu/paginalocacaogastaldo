---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopoServico from './TopoServico.astro';
import Passos from './Passos.astro';
import LinkBlog from './LinkBlog.astro';
import Coberturas from './Coberturas.astro';
import Assistencias from './Assistencias.astro';
import Pagamento from './Pagamento.astro';
import ListaDocumentos from './ListaDocumentos.astro';
import OutrasGarantias from './OutrasGarantias.astro';
import Diferenciais from './Diferenciais.astro';
import Faq from './Faq.astro';
import ChamadoFinal from './ChamadoFinal.astro';
import Beneficios from '../home/Beneficios.astro';
import Cidades from '../home/Cidades.astro';
import { site } from '../../data/site';
import { cidades } from '../../data/cidades';
import { solucoes } from '../../data/solucoes';
import { schemaServico } from '../../lib/schema';
import ImagemReservada from '../ImagemReservada.astro';
import type { Servico } from '../../data/servicos/tipos';
import type { ImageMetadata } from 'astro';

// Monta uma página de serviço inteira a partir do arquivo de dados.
// Ordem fixa, igual em todas as páginas de serviço: topo, o que é, passo a passo, vantagens,
// coberturas, [assistências], [pagamento], [quem pode], outras garantias, por que, cidades, FAQ, final.
// Seções entre colchetes só aparecem se o serviço tiver esse conteúdo.
// fotoTopo troca a foto do topo (padrão: a do card do serviço na Home);
// fotosOQueE coloca imagens ao lado do texto do "O que é" (sem src fica o espaço reservado).
type Foto = { src?: ImageMetadata; alt: string; descricao: string };
interface Props { servico: Servico; idPassos?: string; fotoTopo?: { src: ImageMetadata; alt: string }; fotosOQueE?: Foto[] }
const { servico: s, idPassos = 'como-funciona', fotoTopo, fotosOQueE = [] } = Astro.props;

const caminho = `/${s.slug}`;
const jsonLd = schemaServico(site, { nome: s.nome, descricao: s.seo.description, caminho, rotulo: s.rotuloTrilha }, s.faq.itens, cidades);
// Foto do topo: a mesma do card deste serviço na Home
const foto = fotoTopo ?? solucoes.find((x) => x.saibaMais === caminho)?.imagem;
const passoAPasso = s.comoFunciona;
// Padrão: a seção de informações (assistências ou, sem elas, coberturas) termina com a simulação
// "Outras garantias" é cinza, a menos que a seção anterior também seja (evita duas faixas cinza seguidas)
const antesDasOutrasCinza = !s.quemPode && Boolean(s.pagamento || s.assistencias);
const simulacao = { rotulo: 'Fazer simulação', href: s.topo.botaoPrincipal.href };
---

<BaseLayout title={s.seo.title} description={s.seo.description} path={caminho} jsonLd={jsonLd} mensagemWhatsApp={s.mensagemWhatsApp}>
  <main id="conteudo">
    <TopoServico servico={s} foto={foto} />

    <section id="o-que-e" class="secao texto-servico" aria-labelledby="o-que-e-titulo">
      <div class:list={['container', { 'texto-servico__grade': fotosOQueE.length > 0 }]}>
        <div>
        <h2 id="o-que-e-titulo">{s.oQueE.titulo}</h2>
        {s.oQueE.paragrafos.map((p) => <p>{p}</p>)}
        <LinkBlog link={s.oQueE.link} />
        {s.oQueE.extra && (
          <div class="texto-servico__extra">
            <h3>{s.oQueE.extra.titulo}</h3>
            <p>{s.oQueE.extra.texto}</p>
          </div>
        )}
        </div>
        {fotosOQueE.length > 0 && (
          <div class="texto-servico__fotos">
            {fotosOQueE.map((f, i) => (
              <ImagemReservada descricao={f.descricao} proporcao="4/5" raio={i === 0 ? 'escudo' : 'g'} src={f.src} alt={f.alt} sizes="(min-width: 900px) 260px, 45vw" />
            ))}
          </div>
        )}
      </div>
    </section>

    {passoAPasso && <Passos id={idPassos} {...passoAPasso} />}

    <Beneficios id="vantagens" titulo={s.vantagens.titulo} intro={s.vantagens.intro ?? ''} grupos={s.vantagens.grupos} rotuloAbas="Vantagens por público" />

    <Coberturas coberturas={s.coberturas} botao={s.assistencias ? undefined : simulacao} />

    {s.assistencias && <Assistencias assistencias={s.assistencias} botao={simulacao} />}

    {s.pagamento && <Pagamento pagamento={s.pagamento} />}

    {s.quemPode && <ListaDocumentos quemPode={s.quemPode} />}

    <OutrasGarantias outras={s.outras} atual={caminho} fundo={antesDasOutrasCinza ? 'branco' : 'cinza'} />

    <Diferenciais porQue={s.porQue} />

    <Cidades />

    <Faq titulo={s.faq.titulo} itens={s.faq.itens} />

    <ChamadoFinal titulo={s.final.titulo} texto={s.final.texto} principal={s.topo.botaoPrincipal} secundario={s.final.botaoSecundario} mensagemWhatsApp={s.mensagemWhatsApp} />
  </main>
</BaseLayout>

<style>
  .texto-servico p { max-width: 70ch; color: var(--texto); }
  .texto-servico__grade { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .texto-servico__fotos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; align-items: end; }
  .texto-servico__fotos > :global(.foto:last-child) { margin-bottom: 2.5rem; }
  @media (max-width: 900px) {
    .texto-servico__grade { grid-template-columns: minmax(0, 1fr); }
  }
  .texto-servico__extra { margin-top: 2rem; max-width: 70ch; padding: 1.25rem 1.4rem; background: var(--cinza-fundo); border: 1.5px solid #bccbdd; border-radius: var(--raio-p); }
  .texto-servico__extra h3 { font-size: 1.0625rem; margin-bottom: 0.5rem; }
  .texto-servico__extra p { margin: 0; }
</style>
