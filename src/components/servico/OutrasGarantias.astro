---
import CardSolucao from '../CardSolucao.astro';
import LinkBlog from './LinkBlog.astro';
import { solucoes, type Solucao } from '../../data/solucoes';
import type { Servico } from '../../data/servicos/tipos';

// Outras garantias com o mesmo card da Home (foto, título, texto e "Saiba mais").
// A foto vem do card da Home com o mesmo link; sem card na Home, fica o espaço reservado.
interface Props { outras: Servico['outras'] }
const { outras: o } = Astro.props;
const cards: Solucao[] = o.itens.map((i) => {
  const daHome = solucoes.find((s) => s.saibaMais === i.href);
  return {
    titulo: i.titulo,
    texto: i.texto,
    saibaMais: i.href,
    acao: { rotulo: 'Simular', href: i.href },
    foto: daHome?.foto ?? 'Empresa em imóvel comercial alugado',
    imagem: daHome?.imagem,
  };
});
---

<section id="outras-garantias" class="secao outras" aria-labelledby="outras-titulo">
  <div class="container">
    <h2 id="outras-titulo">{o.titulo}</h2>
    <p class="intro">{o.intro}</p>
    <ul class="outras__lista">
      {cards.map((c) => <li><CardSolucao solucao={c} /></li>)}
    </ul>
    <LinkBlog link={o.link} />
  </div>
</section>

<style>
  .outras { background: var(--cinza-fundo); }
  .outras .intro { max-width: 62ch; margin-bottom: 1.75rem; }
  .outras__lista { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  @media (max-width: 800px) {
    .outras__lista { grid-template-columns: minmax(0, 1fr); }
  }
</style>
