---
import Botao from '../Botao.astro';
import { site } from '../../data/site';
import { icones } from '../../lib/icones';
import { linkWhatsApp } from '../../lib/whatsapp';
import type { Servico } from '../../data/servicos/tipos';

// Faixa de destaque: título, texto e botão de WhatsApp, com um ícone grande e suave ao fundo
// (mesma textura das faixas de pagamento e assistências)
interface Props { destaque: NonNullable<Servico['destaque']>; fundo?: 'cinza' | 'branco' }
const { destaque: d, fundo = 'cinza' } = Astro.props;
---

<section id={d.id} class:list={['secao destaque', { 'destaque--branco': fundo === 'branco' }]} aria-labelledby={`${d.id}-titulo`}>
  <svg class="destaque__marca" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d={icones[d.icone]}></path></svg>
  <div class="container destaque__grade">
    <div>
      <h2 id={`${d.id}-titulo`}>{d.titulo}</h2>
      <p>{d.texto}</p>
    </div>
    <Botao href={linkWhatsApp(d.mensagemWhatsApp, site.whatsapp)} variante="whatsapp">{d.botao}</Botao>
  </div>
</section>

<style>
  .destaque { background: var(--cinza-fundo); position: relative; overflow: hidden; }
  .destaque--branco { background: var(--branco); }
  .destaque__grade { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem 4rem; align-items: center; }
  .destaque__marca {
    position: absolute; left: clamp(6rem, 22vw, 24rem); top: 50%; width: clamp(300px, 34vw, 460px); height: auto;
    color: #dbe4ef; opacity: 0.5; transform: translateY(-50%) rotate(-12deg); pointer-events: none;
  }
  .destaque p { max-width: 64ch; margin: 0; }
  @media (max-width: 760px) {
    .destaque__grade { grid-template-columns: minmax(0, 1fr); justify-items: start; }
    .destaque__marca { left: 15%; top: 32%; width: 320px; }
  }
</style>
