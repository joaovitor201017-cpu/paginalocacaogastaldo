---
import CarrosselTreinamentos from '../CarrosselTreinamentos.astro';
import RedesSociais from '../RedesSociais.astro';
import { icones } from '../../lib/icones';
import type { Servico } from '../../data/servicos/tipos';

// "Por que a Gastaldo", no mesmo formato do Sobre da Home:
// texto e diferenciais compactos à esquerda, carrossel dos treinamentos à direita.
interface Props { porQue: Servico['porQue'] }
const { porQue: p } = Astro.props;
---

<section id="por-que" class="secao por-que" aria-labelledby="por-que-titulo">
  <div class="container por-que__grade">
    <div class="por-que__texto">
      <h2 id="por-que-titulo">{p.titulo}</h2>
      <p>{p.texto}</p>
      <h3>{p.diferenciaisTitulo}</h3>
      <ul class="diferenciais">
        {p.diferenciais.map((d) => (
          <li class="diferencial">
            <span class="diferencial__icone" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={icones[d.icone]}></path></svg>
            </span>
            <strong>{d.destaque}</strong>
          </li>
        ))}
      </ul>
      <div class="por-que__redes">
        <p>Acompanhe a Gastaldo nas redes</p>
        <RedesSociais />
      </div>
    </div>
    <CarrosselTreinamentos />
  </div>
</section>

<style>
  .por-que__grade { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .por-que__texto p { max-width: 54ch; }
  .por-que__redes { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-top: 1.5rem; }
  .por-que__redes p { margin: 0; font-size: 0.9375rem; font-weight: 600; color: var(--marinho); }
  .por-que h3 { font-size: 0.975rem; margin: 1.75rem 0 0.75rem; }
  .diferenciais { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
  .diferencial { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.75rem; background: var(--cinza-fundo); border-radius: var(--raio-p); }
  .diferencial strong { color: var(--marinho); font-size: 0.8125rem; font-weight: 600; line-height: 1.3; }
  .diferencial__icone {
    flex: 0 0 auto; display: grid; place-items: center; width: 32px; height: 32px;
    color: var(--marinho); background: var(--azul-ceu);
    border-radius: 8px 8px 8px 14px; /* eco do escudo do logo */
  }
  @media (max-width: 900px) {
    .por-que__grade { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 420px) {
    .diferenciais { grid-template-columns: minmax(0, 1fr); }
  }
</style>
