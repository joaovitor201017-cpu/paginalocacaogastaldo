---
import LinkBlog from './LinkBlog.astro';
import Botao from '../Botao.astro';
import { icones } from '../../lib/icones';
import type { Acao, Servico } from '../../data/servicos/tipos';

// Coberturas em cards, no mesmo formato dos benefícios: faixa que rola para o lado,
// com setas no desktop e arrastar no celular.
// botao: chamada de simulação ao fim da seção (quando a página não tem assistências)
interface Props { coberturas: Servico['coberturas']; botao?: Acao }
const { coberturas: c, botao } = Astro.props;
---

<section id="coberturas" class="secao coberturas" aria-labelledby="coberturas-titulo">
  <div class="container">
    <div class="coberturas__topo">
      <h2 id="coberturas-titulo">{c.titulo}</h2>
      <p class="intro">{c.intro}</p>
    </div>

    <div data-faixa>
      <div class="coberturas__cabeca">
        <h3 id="coberturas-lista">{c.tabelaTitulo}</h3>
        <div class="coberturas__setas">
          <button type="button" data-dir="-1" aria-label="Coberturas anteriores">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
          </button>
          <button type="button" data-dir="1" aria-label="Próximas coberturas">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </div>
      </div>
      <ul class="coberturas__faixa" data-trilha tabindex="0" aria-labelledby="coberturas-lista">
        {c.linhas.map((l) => (
          <li class="cobertura">
            <div class="cobertura__topo">
              <span class="cobertura__icone" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icones[l.icone]}></path></svg>
              </span>
              <span class:list={['cobertura__tipo', { 'cobertura__tipo--basica': l.tipo === 'Básica' }]}>{l.tipo}</span>
            </div>
            <strong>{l.cobertura}</strong>
            <p>{l.paga}</p>
            {l.limite && <p class="cobertura__limite"><span>Limite</span>{l.limite}</p>}
          </li>
        ))}
      </ul>
    </div>
    <p class="coberturas__nota">{c.nota}</p>

    {c.assistencias && (
      <div class="coberturas__assist">
        <h3>{c.assistencias.titulo}</h3>
        <p>{c.assistencias.texto}</p>
      </div>
    )}
    <LinkBlog link={c.link} />
    {botao && <div class="coberturas__acao"><Botao href={botao.href}>{botao.rotulo}</Botao></div>}
  </div>
</section>

<script is:inline>
  // Setas da faixa de coberturas (desativadas nas pontas)
  document.querySelectorAll('[data-faixa]').forEach((f) => {
    const g = f.querySelector('[data-trilha]'), [a, b] = f.querySelectorAll('[data-dir]');
    const at = () => { a.disabled = g.scrollLeft < 5; b.disabled = g.scrollLeft + g.clientWidth > g.scrollWidth - 5; };
    a.onclick = b.onclick = (e) => g.scrollBy({ left: e.currentTarget.dataset.dir * g.clientWidth * 0.8, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    g.addEventListener('scroll', at, { passive: true });
    addEventListener('resize', at);
    at();
  });
</script>

<style>
  .coberturas__topo { max-width: 62ch; margin-bottom: 1.75rem; }
  .coberturas__topo .intro { margin: 0; }
  .coberturas h3 { font-size: 1rem; margin: 0; }

  .coberturas__cabeca { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.75rem; }
  .coberturas__setas { display: none; gap: 0.4rem; }
  :global(.js) .coberturas__setas { display: flex; }
  .coberturas__setas button {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%;
    border: 1.5px solid #bccbdd; background: var(--branco); color: var(--marinho); cursor: pointer;
  }
  .coberturas__setas button:hover:not(:disabled) { background: var(--marinho); border-color: var(--marinho); color: var(--branco); }
  .coberturas__setas button:disabled { opacity: 0.35; cursor: default; }

  .coberturas__faixa {
    display: grid; grid-auto-flow: column; grid-auto-columns: 220px; gap: 0.75rem;
    overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 0.5rem; scrollbar-width: thin;
  }
  .coberturas__faixa:focus-visible { outline-offset: 4px; }
  .cobertura {
    display: flex; flex-direction: column; gap: 0.5rem;
    padding: 0.9rem 0.85rem; background: var(--branco);
    border: 1.5px solid #bccbdd; border-radius: var(--raio-p);
    scroll-snap-align: start; transition: border-color 0.18s ease;
  }
  .cobertura:hover { border-color: var(--azul-claro); }
  .cobertura__topo { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.25rem; }
  .cobertura__icone {
    display: grid; place-items: center; width: 44px; height: 44px;
    color: var(--marinho); background: var(--azul-ceu);
    border-radius: 10px 10px 10px 20px; /* eco do escudo do logo */
  }
  .cobertura__tipo { padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; background: var(--cinza-fundo); color: var(--marinho); border: 1px solid var(--cinza-linha); }
  .cobertura__tipo--basica { background: var(--marinho); color: var(--branco); border-color: var(--marinho); }
  .cobertura strong { color: var(--marinho); font-size: 0.9375rem; line-height: 1.3; }
  .cobertura p { margin: 0; font-size: 0.875rem; line-height: 1.5; color: var(--texto-suave); }
  .cobertura .cobertura__limite { margin-top: auto; padding-top: 0.6rem; border-top: 1px solid var(--cinza-linha); color: var(--marinho); font-weight: 500; }
  .cobertura__limite span { display: block; font-size: 0.75rem; font-weight: 600; color: var(--texto-suave); }

  .coberturas__nota { margin: 0.75rem 0 0; font-size: 0.8125rem; color: var(--texto-suave); max-width: 80ch; }
  .coberturas__assist { margin-top: 2.25rem; max-width: 62ch; }
  .coberturas__assist h3 { font-size: 1.0625rem; margin-bottom: 0.6rem; }
  .coberturas__assist p { margin: 0; }
  .coberturas__acao { margin-top: 1.75rem; }

  @media (max-width: 560px) {
    .coberturas__setas { display: none !important; }
    .coberturas__faixa { grid-auto-columns: 72%; margin-inline: -1.25rem; padding-inline: 1.25rem; scroll-padding-inline: 1.25rem; }
  }
</style>
