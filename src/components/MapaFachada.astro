---
// Fachada do Google Maps: o iframe (pesado) só carrega quando a pessoa clica
interface Props { consulta: string; rotulo: string }
const { consulta, rotulo } = Astro.props;
const src = `https://www.google.com/maps?q=${encodeURIComponent(consulta)}&output=embed`;
---

<div class="mapa" data-src={src}>
  <div class="mapa__fachada">
    <svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21Z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
    <p>{rotulo}</p>
    <button type="button" class="mapa__botao">Ver no mapa</button>
  </div>
</div>

<script is:inline>
  // Troca a fachada pelo iframe do Google Maps no clique
  document.querySelectorAll('.mapa').forEach((m) => {
    m.querySelector('.mapa__botao')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = m.dataset.src;
      f.title = 'Mapa da Gastaldo Seguros';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      m.replaceChildren(f);
    });
  });
</script>

<style>
  .mapa { aspect-ratio: 16 / 10; border-radius: var(--raio-m); overflow: hidden; background: var(--cinza-fundo); border: 1px solid var(--cinza-linha); }
  .mapa__fachada {
    height: 100%; display: grid; place-content: center; justify-items: center; gap: 0.5rem; padding: 1.5rem; text-align: center; color: var(--marinho);
    background-image: radial-gradient(var(--cinza-linha) 1px, transparent 1px);
    background-size: 18px 18px;
  }
  .mapa__fachada svg { color: var(--azul); }
  .mapa__fachada p { margin: 0; font-weight: 500; max-width: 32ch; }
  .mapa__botao { font: inherit; font-weight: 600; color: var(--azul-escuro); background: var(--branco); border: 2px solid var(--azul); border-radius: 999px; padding: 0.55rem 1.2rem; cursor: pointer; margin-top: 0.4rem; }
  .mapa__botao:hover { background: var(--azul); color: var(--branco); }
  .mapa :global(iframe) { width: 100%; height: 100%; border: 0; }
</style>
