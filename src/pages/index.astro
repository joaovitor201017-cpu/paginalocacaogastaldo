---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FaixaLogos from '../components/home/FaixaLogos.astro';
import Solucoes from '../components/home/Solucoes.astro';
import Beneficios from '../components/home/Beneficios.astro';

const title = 'Soluções para Alugar no ABC | Garantias Locatícias – Gastaldo';
const description =
  'Soluções para alugar sem fiador ou caução no ABC: seguro fiança, título de capitalização, seguro incêndio e residencial. Corretora parceira das imobiliárias da região.';
---

<BaseLayout title={title} description={description} path="/">
  <main id="conteudo">
    <Hero />
    <FaixaLogos />
    <Solucoes />
    <Beneficios />
  </main>
</BaseLayout>
