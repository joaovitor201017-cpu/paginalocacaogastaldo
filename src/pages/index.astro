---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FaixaLogos from '../components/home/FaixaLogos.astro';
import Solucoes from '../components/home/Solucoes.astro';
import Beneficios from '../components/home/Beneficios.astro';
import Parceiras from '../components/home/Parceiras.astro';
import Sobre from '../components/home/Sobre.astro';
import Cidades from '../components/home/Cidades.astro';
import Contato from '../components/home/Contato.astro';
import { site } from '../data/site';
import { cidades } from '../data/cidades';
import { schemaHome } from '../lib/schema';

const title = 'Soluções para Alugar no ABC | Garantias Locatícias – Gastaldo';
const description =
  'Soluções para alugar sem fiador ou caução no ABC: seguro fiança, título de capitalização, seguro incêndio e residencial. Corretora parceira das imobiliárias da região.';
---

<BaseLayout title={title} description={description} path="/" jsonLd={schemaHome(site, [], cidades)}>
  <main id="conteudo">
    <Hero />
    <FaixaLogos />
    <Solucoes />
    <Beneficios />
    <Parceiras />
    <Sobre />
    <Cidades />
    <Contato />
  </main>
</BaseLayout>
