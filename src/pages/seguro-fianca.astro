---
import PaginaServico from '../components/servico/PaginaServico.astro';
import { seguroFianca } from '../data/servicos/seguro-fianca';
import fotoInquilina from '../assets/fotos/fianca-inquilina-contrato.jpg';
import fotoProprietario from '../assets/fotos/fianca-proprietario.jpg';
---

<PaginaServico
  servico={seguroFianca}
  idPassos="como-funciona"
  fotosOQueE={[
    { src: fotoInquilina, alt: 'Inquilina assinando o contrato de aluguel sem fiador', descricao: 'Foto: inquilina assinando o contrato' },
    { src: fotoProprietario, alt: 'Proprietário tranquilo com o aluguel garantido pelo seguro fiança', descricao: 'Foto: proprietário tranquilo' },
  ]}
/>
