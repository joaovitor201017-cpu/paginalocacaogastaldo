---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopoServico from '../components/servico/TopoServico.astro';
import Passos from '../components/servico/Passos.astro';
import LinkBlog from '../components/servico/LinkBlog.astro';
import TabelaCoberturas from '../components/servico/TabelaCoberturas.astro';
import ListaDocumentos from '../components/servico/ListaDocumentos.astro';
import Beneficios from '../components/home/Beneficios.astro';
import Botao from '../components/Botao.astro';
import OutrasGarantias from '../components/servico/OutrasGarantias.astro';
import Diferenciais from '../components/servico/Diferenciais.astro';
import Faq from '../components/servico/Faq.astro';
import ChamadoFinal from '../components/servico/ChamadoFinal.astro';
import Cidades from '../components/home/Cidades.astro';
import MapaFachada from '../components/MapaFachada.astro';
import { enderecoCompleto } from '../lib/endereco';
import { linkWhatsApp } from '../lib/whatsapp';
import { seguroFianca as s } from '../data/servicos/seguro-fianca';
import { site } from '../data/site';
import { cidades } from '../data/cidades';
import { schemaServico } from '../lib/schema';

const caminho = `/${s.slug}`;
const jsonLd = schemaServico(site, { nome: s.nome, descricao: s.seo.description, caminho, rotulo: s.rotuloTrilha }, s.faq.itens, cidades);
---

<BaseLayout title={s.seo.title} description={s.seo.description} path={caminho} jsonLd={jsonLd} mensagemWhatsApp={s.mensagemWhatsApp}>
  <main id="conteudo">
    <TopoServico servico={s} />

    <section id="o-que-e" class="secao texto-servico" aria-labelledby="o-que-e-titulo">
      <div class="container estreito">
        <h2 id="o-que-e-titulo">{s.oQueE.titulo}</h2>
        {s.oQueE.paragrafos.map((p) => <p>{p}</p>)}
        <LinkBlog link={s.oQueE.link} />
      </div>
    </section>

    <Passos id="como-funciona" titulo={s.comoFunciona.titulo} intro={s.comoFunciona.intro} passos={s.comoFunciona.passos} />

    <TabelaCoberturas coberturas={s.coberturas} />

    <Beneficios id="vantagens" titulo={s.vantagens.titulo} intro={s.vantagens.intro} grupos={s.vantagens.grupos} rotuloAbas="Vantagens por público" />

    <section id="pagamento" class="secao pagamento" aria-labelledby="pagamento-titulo">
      <div class="container pagamento__grade">
        <div>
          <h2 id="pagamento-titulo">{s.pagamento.titulo}</h2>
          <p>{s.pagamento.texto}</p>
          <LinkBlog link={s.pagamento.link} />
        </div>
        <Botao href={s.pagamento.botao.href} tamanho="g">{s.pagamento.botao.rotulo}</Botao>
      </div>
    </section>

    <ListaDocumentos quemPode={s.quemPode} />

    <OutrasGarantias outras={s.outras} />

    <Diferenciais porQue={s.porQue} />

    <Cidades titulo={s.cidades.titulo} texto={s.cidades.texto}>
      <p class="contato-linha">
        {site.endereco && <span><strong>Endereço:</strong> {enderecoCompleto(site.endereco)}</span>}
        {site.whatsapp && <span><strong>Telefone/WhatsApp:</strong> <a href={linkWhatsApp(s.mensagemWhatsApp, site.whatsapp)}>{site.whatsapp}</a></span>}
        {site.horario && <span><strong>Horário:</strong> {site.horario}</span>}
      </p>
      <div slot="abaixo" class="container mapa-servico">
        <MapaFachada consulta={site.endereco ? enderecoCompleto(site.endereco) : `${site.nome}, ${site.cidadeSede} - SP`} rotulo={`${site.nome} · ${site.endereco ? `${site.endereco.bairro}, ${site.endereco.cidade}` : site.cidadeSede}`} />
      </div>
    </Cidades>

    <Faq titulo={s.faq.titulo} itens={s.faq.itens} />

    <ChamadoFinal titulo={s.final.titulo} texto={s.final.texto} principal={s.topo.botaoPrincipal} secundario={s.final.botaoSecundario} mensagemWhatsApp={s.mensagemWhatsApp} />
  </main>
</BaseLayout>

<style>
  .estreito { max-width: 760px; }
  .texto-servico p { color: var(--texto); }
  .pagamento { background: var(--cinza-fundo); }
  .pagamento__grade { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem 4rem; align-items: center; }
  .pagamento p { max-width: 64ch; margin: 0; }
  .contato-linha { display: grid; gap: 0.35rem; margin: 1.25rem 0 0; font-size: 0.9375rem; }
  .contato-linha strong { color: var(--marinho); }
  .mapa-servico { margin-top: 2.5rem; }
  @media (max-width: 760px) {
    .pagamento__grade { grid-template-columns: minmax(0, 1fr); justify-items: start; }
  }
</style>
