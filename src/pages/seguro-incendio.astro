---
import PaginaServico from '../components/servico/PaginaServico.astro';
import { seguroIncendio } from '../data/servicos/seguro-incendio';
import fotoVistoria from '../assets/fotos/incendio-vistoria.jpg';
---

<PaginaServico
  servico={seguroIncendio}
  idPassos="como-contratar"
  fotosOQueE={[
    { src: fotoVistoria, alt: 'Vistoriador da seguradora conversando com a moradora na cozinha', descricao: 'Foto: vistoria', posicao: '25% 50%' },
    // Foto a gerar: salve em src/assets/fotos/ e preencha o src (import)
    { alt: 'Sala de apartamento alugado com detector de fumaça no teto', descricao: 'Foto: detector de fumaça no imóvel' },
  ]}
/>
