---
import PaginaServico from '../components/servico/PaginaServico.astro';
import { seguroIncendio } from '../data/servicos/seguro-incendio';
import fotoVistoria from '../assets/fotos/incendio-vistoria.jpg';
import fotoDetector from '../assets/fotos/incendio-detector.jpg';
---

<PaginaServico
  servico={seguroIncendio}
  idPassos="como-contratar"
  fotosOQueE={[
    { src: fotoVistoria, alt: 'Vistoriador da seguradora conversando com a moradora na cozinha', descricao: 'Foto: vistoria', posicao: '52% 50%' },
    { src: fotoDetector, alt: 'Morador testando o detector de fumaça na sala do apartamento alugado', descricao: 'Foto: detector de fumaça', posicao: '58% 50%' },
  ]}
/>
