---
import PaginaSimulador from '../components/simulador/PaginaSimulador.astro';
import Passos from '../components/servico/Passos.astro';
import CotacaoIncendio from '../components/simulador/CotacaoIncendio.astro';
import { cotacaoIncendio as s } from '../data/simuladores/seguro-incendio';

// Cotação de seguro incêndio para aluguel: formulário no topo e o texto de SEO abaixo dele
---

<PaginaSimulador
  slug={s.slug}
  nomeApp="Cotação de Seguro Incêndio para Aluguel"
  seo={s.seo}
  mensagemWhatsApp={s.mensagemWhatsApp}
  h1={s.h1}
  subtitulo={s.subtitulo}
  selos={s.selos}
  servico={{ rotulo: 'Seguro Incêndio', href: '/seguro-incendio' }}
  rotuloAtual="Cotação"
  abc={s.abc}
  faq={s.faq}
  final={s.final}
>
  <CotacaoIncendio slot="calculadora" />

  <Passos id="como-funciona" titulo={s.comoFunciona.titulo} passos={s.comoFunciona.passos} />

  <section class="secao cot-textos" aria-label="Cobertura e preço">
    <div class="container cot-textos__grade">
      {s.textos.map((t) => (
        <div id={t.id}>
          <h2>{t.titulo}</h2>
          <p>{t.texto}</p>
        </div>
      ))}
    </div>
  </section>
</PaginaSimulador>

<style>
  .cot-textos__grade { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 5vw, 4.5rem); }
  .cot-textos p { margin: 0; max-width: 60ch; }
  @media (max-width: 760px) {
    .cot-textos__grade { grid-template-columns: minmax(0, 1fr); }
  }
</style>
