---
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlutuante from '../components/WhatsAppFlutuante.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  mensagemWhatsApp?: string; // mensagem do botão flutuante (padrão: a do site)
  indexar?: boolean; // false: nunca indexar (ex.: página 404)
}

const { title, description, path, jsonLd = [], mensagemWhatsApp, indexar = true } = Astro.props;
const canonical = site.dominio ? new URL(path, site.dominio).href : null;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {/* Sem domínio final (endereço provisório): não indexar */}
    {(!site.dominio || !indexar) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
    {/* Ícone da aba: escudo da Gastaldo (recortado do logo) */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#043967" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <slot />
    <Footer />
    <WhatsAppFlutuante mensagem={mensagemWhatsApp} />
  </body>
</html>
